---
// renderLibraryIndex() прототипа: библиотека как фильтруемая коллекция.
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import BookCover from '../components/BookCover.astro';
import ShowcaseSidebar from '../components/ShowcaseSidebar.astro';
import CollectionSearchControls from '../components/CollectionSearchControls.astro';
import { plainText } from '../lib/rich-text';
import { UI, type Language } from '../lib/site';
import { getCollectionEntries, getEntry } from '../lib/registry';

interface Props {
  language: Language;
}

const { language } = Astro.props;
const labels = UI[language];
const page = (await getEntry(language, 'library')).data;
const books = await getCollectionEntries(language, 'book', page.pinned ?? []);
const showcase = Array.isArray(page.showcase) ? page.showcase : [];
---

<Base language={language} title={plainText(page.title)} description={plainText(page.summary)} active="library" pageKind="library-index">
  <PageHeader language={language} eyebrow={page.eyebrow} title={page.title} lead={page.summary} />
  <div class:list={['shell', 'index-layout', { 'index-layout--single': showcase.length === 0 }]}>
    <ShowcaseSidebar language={language} title={page.showcaseTitle ?? labels.startHere} items={showcase} />
    <section class="index-main" aria-label={plainText(page.title)}>
      <CollectionSearchControls language={language} collectionType="book" placeholder={page.searchPlaceholder ?? ''} resultsId="library-results" />
      <section id="library-results" class="article-list" aria-live="polite">
        {books.map((book) => (
          <a class="article-row article-row--media" data-component="article-row" href={book.url}>
            <span class="article-row__cover">
              {book.data.cover ? (
                <img class="book-cover book-cover--image" src={book.data.cover} alt={`${language === 'ru' ? 'Обложка' : 'Cover of'} ${book.title}`} loading="lazy" decoding="async" />
              ) : (
                <BookCover title={book.title} authors={book.data.authors} />
              )}
            </span>
            <span class="article-row__main">
              <strong>{book.title}</strong>
              <span>{book.summary}</span>
            </span>
            <span class="article-row__meta">
              <b>{book.data.authors.join(' · ')}</b>
              <small>{book.data.publication ?? book.data.readingStatus}</small>
            </span>
          </a>
        ))}
      </section>
    </section>
  </div>
</Base>
