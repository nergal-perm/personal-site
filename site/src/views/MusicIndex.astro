---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import AlbumCover from '../components/AlbumCover.astro';
import ShowcaseSidebar from '../components/ShowcaseSidebar.astro';
import CollectionSearchControls from '../components/CollectionSearchControls.astro';
import { plainText } from '../lib/rich-text';
import { UI, formatDate, type Language } from '../lib/site';
import { getCollectionEntries, getEntry } from '../lib/registry';

interface Props {
  language: Language;
}

const { language } = Astro.props;
const labels = UI[language];
const page = (await getEntry(language, 'music')).data;
const albums = await getCollectionEntries(language, 'album', page.pinned ?? []);
const showcase = Array.isArray(page.showcase) ? page.showcase : [];
---

<Base language={language} title={plainText(page.title)} description={plainText(page.summary)} active="music" pageKind="music-index">
  <PageHeader language={language} eyebrow={page.eyebrow} title={page.title} lead={page.summary} />
  <div class:list={['shell', 'index-layout', { 'index-layout--single': showcase.length === 0 }]}>
    {showcase.length > 0 && <ShowcaseSidebar language={language} title={page.showcaseTitle ?? labels.startHere} items={showcase} />}
    <section class="index-main" aria-label={plainText(page.title)}>
      <CollectionSearchControls language={language} collectionType="album" placeholder={page.searchPlaceholder ?? ''} resultsId="music-results" />
      <section id="music-results" class="article-list" aria-live="polite">
        {albums.map((item) => (
          <a class="article-row article-row--media" data-component="article-row" href={item.url}>
            <span class="article-row__cover">
              {item.data.cover ? (
                <img class="album-cover album-cover--suite album-cover--image" src={item.data.cover} alt={`${item.data.work} — ${item.data.artist}`} loading="lazy" decoding="async" />
              ) : (
                <AlbumCover alt={`${item.data.work} — ${item.data.artist}`} />
              )}
            </span>
            <span class="article-row__main">
              <strong>{item.title}</strong>
              <span>{item.summary}</span>
            </span>
            <span class="article-row__meta">
              <b>{item.data.artist}</b>
              <small>{[item.data.releaseDate && formatDate(item.data.releaseDate, language), item.data.format].filter(Boolean).join(' · ')}</small>
            </span>
          </a>
        ))}
      </section>
    </section>
  </div>
</Base>
