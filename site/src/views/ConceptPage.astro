---
// renderConcept() прототипа: определение, «что не является», отношения, примеры.
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Callout from '../components/Callout.astro';
import RelatedStrip from '../components/RelatedStrip.astro';
import { UI, type Language } from '../lib/site';
import { type SiteEntry } from '../lib/registry';

interface Props {
  language: Language;
  entry: SiteEntry;
  Content: any;
  hasBody: boolean;
}

const { language, entry, Content, hasBody } = Astro.props;
const labels = UI[language];
const data = entry.data;
const label = `${entry.typeLabel} · ${language === 'ru' ? 'Практика работы' : 'Working practice'}`;
---

<Base language={language} title={entry.title} description={entry.summary} active="notes" pageKind="concept">
  <article class="concept-page">
    <PageHeader
      language={language}
      eyebrow={label}
      title={entry.title}
      lead={entry.summary}
      date={entry.date}
      updated={entry.updated}
    />
    <div class="shell concept-body">
      {hasBody && <div class="concept-markdown markdown-content"><Content /></div>}
      {data.notThis && <Callout kind="boundary" label={labels.notThis} text={data.notThis} />}
      <section>
        <div class="numbered-heading"><span>02</span><h2>{labels.relations}</h2></div>
        <div class="relation-list">
          {data.relations.map((relation: { name: string; relation: string }) => (
            <div><strong>{relation.name}</strong><span>{relation.relation}</span></div>
          ))}
        </div>
      </section>
      <section>
        <div class="numbered-heading"><span>03</span><h2>{labels.examples}</h2></div>
        <ul class="example-list">
          {data.examples.map((example: string) => (
            <li>{example}</li>
          ))}
        </ul>
      </section>
    </div>
    <RelatedStrip language={language} links={entry.links} />
  </article>
</Base>
