---
// Запасная типографическая обложка альбома (renderMusicIndex/renderAlbum).
interface Props {
  size?: 'default' | 'large' | 'xl';
  alt: string;
}

const { size = 'default', alt } = Astro.props;
const sizeClass = size === 'large' ? 'album-cover--large' : size === 'xl' ? 'album-cover--xl' : '';
---

<div class:list={['album-cover', 'album-cover--suite', sizeClass]} role="img" aria-label={alt}>
  <span>SUITE</span><i></i>
</div>
