---
import "@fontsource/source-serif-4/400.css";
import "@fontsource/source-serif-4/400-italic.css";
import "@fontsource/source-serif-4/600.css";
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/global.css";

import SiteNav from "../components/SiteNav.astro";
import ProcessFigure from "../components/ProcessFigure.astro";
import RelatedConcepts from "../components/RelatedConcepts.astro";
import BotanicalSprig from "../components/BotanicalSprig.astro";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  data: Record<string, any>;
  headings: Heading[];
}
const { data, headings } = Astro.props;

// Left-rail table of contents: numbered top-level (h2) sections only.
const toc = headings
  .filter((h) => h.depth === 2)
  .map((h, i) => ({ ...h, n: i + 1 }));

const detail = [
  ["Type", data.contentType],
  ["Status", data.status],
  ["Topic", data.topic],
  ["Tags", (data.tags ?? []).join(", ")],
  ["Location", data.location],
  ["Word count", data.wordCount],
  ["Revision", String(data.revision)],
].filter(([, v]) => v);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{data.title} — Evgeny Terekhov</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <SiteNav active="Essays" />

    <div class="shell">
      <div class="grid">
        <!-- ============ LEFT RAIL ============ -->
        <aside class="rail rail-left">
          <nav class="toc" aria-label="On this page">
            <p class="eyebrow">On this page</p>
            <ul>
              <li class="toc-item is-active">
                <a href="#abstract">Abstract</a>
              </li>
              {
                toc.map((h) => (
                  <li class="toc-item">
                    <a href={`#${h.slug}`}>
                      {h.n}. {h.text}
                    </a>
                  </li>
                ))
              }
            </ul>
            <ul class="toc-secondary">
              <li><a href="#figure">Figures</a></li>
              <li><a href="#backlinks">Backlinks</a></li>
            </ul>
          </nav>

          <div class="rail-ornament">
            <BotanicalSprig size={86} />
            <p class="epigraph">
              Clarity comes from structure. <em>Leverage</em> comes from
              iteration.
              <span class="sig">— E. T.</span>
            </p>
          </div>
        </aside>

        <!-- ============ CENTER: READING COLUMN ============ -->
        <main class="reading">
          <header class="post-head">
            <h1 class="post-title">{data.title}</h1>
            <div class="post-meta">
              <span class="meta-dates">
                {data.publishDate}
                {data.updatedDate && (
                  <>
                    <span class="dot">•</span> Updated {data.updatedDate}
                  </>
                )}
                <span class="dot">•</span>
                {data.readingTime}
              </span>
              <span class="type-tag">{data.contentType}</span>
            </div>
          </header>

          <section id="abstract" class="abstract">
            <h2 class="block-label">Abstract</h2>
            <p>{data.abstract}</p>
          </section>

          {
            data.figure && (
              <div id="figure">
                <ProcessFigure
                  label={data.figure.label}
                  title={data.figure.title}
                  caption={data.figure.caption}
                  steps={data.figure.steps}
                />
              </div>
            )
          }

          <article class="article-body">
            <slot />
          </article>
        </main>

        <!-- ============ RIGHT RAIL ============ -->
        <aside class="rail rail-right">
          <section class="panel">
            <p class="eyebrow">Article details</p>
            <dl class="detail-list">
              {
                detail.map(([k, v]) => (
                  <div class="detail-row">
                    <dt>{k}</dt>
                    <dd>{v}</dd>
                  </div>
                ))
              }
            </dl>
          </section>

          {
            data.sources?.length > 0 && (
              <section class="panel">
                <p class="eyebrow">Sources</p>
                <ol class="sources">
                  {data.sources.map((s: any) => (
                    <li>
                      <span class="src-n">[{s.n}]</span>
                      <span class="src-text">{s.text}</span>
                    </li>
                  ))}
                </ol>
                <a class="panel-link" href="#">
                  View all sources →
                </a>
              </section>
            )
          }

          {
            data.related && (
              <section class="panel">
                <p class="eyebrow">Related concepts</p>
                <RelatedConcepts
                  center={data.related.center}
                  nodes={data.related.nodes}
                />
              </section>
            )
          }
        </aside>
      </div>
    </div>

    <!-- ============ BACKLINKS BAND ============ -->
    {
      data.backlinks?.length > 0 && (
        <footer id="backlinks" class="backlinks">
          <div class="backlinks-inner">
            <div class="backlinks-mark">
              <BotanicalSprig size={62} />
            </div>
            <div class="backlinks-body">
              <p class="eyebrow">Backlinks in the atlas</p>
              <ul class="backlink-grid">
                {data.backlinks.map((b: any) => (
                  <li>
                    <a href="#" class="bl-title">
                      {b.title}
                    </a>
                    <span class="bl-sub">{b.sub}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </footer>
      )
    }

    <style>
      .shell {
        max-width: var(--shell-max);
        margin: 0 auto;
        padding: 0 32px;
      }
      .grid {
        display: grid;
        grid-template-columns: 188px minmax(0, 1fr) 280px;
        gap: 44px;
        padding: 48px 0 40px;
        align-items: start;
      }

      /* ---------- rails ---------- */
      .rail {
        font-family: var(--font-sans);
        position: sticky;
        top: 24px;
      }
      .toc ul {
        list-style: none;
        margin: 0 0 22px;
        padding: 0;
      }
      .toc-item {
        margin: 0 0 11px;
        padding-left: 12px;
        border-left: 2px solid transparent;
        line-height: 1.35;
      }
      .toc-item a {
        color: var(--text-muted);
        font-size: 14px;
      }
      .toc-item a:hover {
        color: var(--text);
        text-decoration: none;
      }
      .toc-item.is-active {
        border-left-color: var(--accent);
      }
      .toc-item.is-active a {
        color: var(--text);
      }
      .toc-secondary {
        list-style: none;
        margin: 0;
        padding: 0 0 0 12px;
      }
      .toc-secondary li {
        margin-bottom: 10px;
      }
      .toc-secondary a {
        font-size: 14px;
        color: var(--text-muted);
      }

      .rail-ornament {
        margin-top: 40px;
        color: var(--sea-glass);
      }
      .epigraph {
        font-family: var(--font-serif);
        font-size: 16px;
        line-height: 1.5;
        color: var(--muted-ink);
        margin: 14px 0 0;
        max-width: 20ch;
      }
      .epigraph .sig {
        display: block;
        margin-top: 8px;
        font-style: italic;
      }

      /* ---------- reading column ---------- */
      .reading {
        min-width: 0;
        max-width: var(--reading-measure);
      }
      .post-head {
        margin-bottom: 26px;
      }
      .post-title {
        font-family: var(--font-serif);
        font-weight: 600;
        font-size: 46px;
        line-height: 1.1;
        letter-spacing: -0.01em;
        margin: 0 0 20px;
        color: var(--text);
      }
      .post-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        border-top: 1px solid var(--rule);
        border-bottom: 1px solid var(--rule);
        padding: 12px 0;
      }
      .meta-dates {
        font-family: var(--font-mono);
        font-size: 13px;
        color: var(--text-muted);
        letter-spacing: 0.01em;
      }
      .meta-dates .dot {
        margin: 0 8px;
        color: var(--rule-strong);
      }
      .type-tag {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.14em;
        color: var(--text-muted);
        border: 1px solid var(--rule-strong);
        border-radius: 3px;
        padding: 4px 9px;
        white-space: nowrap;
      }

      .block-label {
        font-family: var(--font-sans);
        font-weight: 600;
        font-size: 21px;
        color: var(--text);
        margin: 0 0 10px;
      }
      .abstract p {
        margin: 0;
      }

      /* ---------- rendered article body ---------- */
      .article-body {
        counter-reset: section;
      }
      .article-body :global(h2:not(.sr-only)) {
        font-family: var(--font-sans);
        font-weight: 600;
        font-size: 21px;
        line-height: 1.3;
        color: var(--text);
        margin: 40px 0 12px;
      }
      .article-body :global(h2:not(.sr-only))::before {
        counter-increment: section;
        content: counter(section) ". ";
        color: var(--text);
      }
      .article-body :global(h3) {
        font-family: var(--font-sans);
        font-weight: 600;
        font-size: 16px;
        margin: 28px 0 8px;
      }
      .article-body :global(p) {
        margin: 0 0 20px;
      }
      .article-body :global(ul),
      .article-body :global(ol) {
        margin: 0 0 20px;
        padding-left: 1.4em;
      }
      .article-body :global(li) {
        margin-bottom: 6px;
      }
      .article-body :global(a) {
        color: var(--link);
        text-decoration: underline;
        text-underline-offset: 2px;
        text-decoration-color: var(--sea-glass);
      }
      .article-body :global(strong) {
        font-weight: 600;
      }
      .article-body :global(em) {
        font-style: italic;
      }
      .article-body :global(blockquote) {
        margin: 26px 0;
        padding: 4px 0 4px 22px;
        border-left: 3px solid var(--signal-amber);
        font-style: italic;
        color: var(--text);
      }
      .article-body :global(blockquote p:last-child) {
        margin-bottom: 0;
      }
      .article-body :global(code) {
        font-family: var(--font-mono);
        font-size: 0.85em;
        background: var(--panel);
        padding: 1px 5px;
        border-radius: 3px;
      }
      .article-body :global(pre) {
        background: var(--panel);
        border: 1px solid var(--rule);
        border-radius: 6px;
        padding: 16px 18px;
        overflow-x: auto;
        font-size: 14px;
      }
      .article-body :global(sup) {
        font-size: 0.7em;
      }
      .article-body :global(.footnotes) {
        margin-top: 44px;
        padding-top: 20px;
        border-top: 1px solid var(--rule);
        font-size: 15px;
        color: var(--text-muted);
      }
      .article-body :global(.sr-only) {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      /* ---------- right rail panels ---------- */
      .panel {
        padding: 0 0 24px;
        margin-bottom: 24px;
        border-bottom: 1px solid var(--rule);
      }
      .panel:last-child {
        border-bottom: 0;
      }
      .detail-list {
        margin: 0;
      }
      .detail-row {
        display: grid;
        grid-template-columns: 88px 1fr;
        gap: 10px;
        margin-bottom: 9px;
        font-size: 13.5px;
        line-height: 1.35;
      }
      .detail-row dt {
        color: var(--text-muted);
      }
      .detail-row dd {
        margin: 0;
        color: var(--text);
      }
      .sources {
        list-style: none;
        margin: 0 0 14px;
        padding: 0;
      }
      .sources li {
        display: grid;
        grid-template-columns: 24px 1fr;
        font-size: 13.5px;
        line-height: 1.4;
        margin-bottom: 12px;
        color: var(--text);
      }
      .src-n {
        color: var(--accent);
        font-family: var(--font-mono);
        font-size: 12.5px;
      }
      .panel-link {
        font-family: var(--font-serif);
        font-style: italic;
        font-size: 15px;
        color: var(--link);
      }

      /* ---------- backlinks band ---------- */
      .backlinks {
        border-top: 1px solid var(--rule-strong);
        background: color-mix(in srgb, var(--panel) 40%, var(--bg));
        margin-top: 24px;
      }
      .backlinks-inner {
        max-width: var(--shell-max);
        margin: 0 auto;
        padding: 26px 32px 30px;
        display: grid;
        grid-template-columns: 132px 1fr;
        gap: 24px;
        align-items: center;
      }
      .backlinks-mark {
        color: var(--sea-glass);
        display: flex;
        justify-content: center;
      }
      .backlink-grid {
        list-style: none;
        margin: 12px 0 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0;
        border-left: 1px solid var(--rule);
      }
      .backlink-grid li {
        padding: 2px 22px;
        border-right: 1px solid var(--rule);
      }
      .backlink-grid li:last-child {
        border-right: 0;
      }
      .bl-title {
        display: block;
        font-family: var(--font-serif);
        font-size: 16px;
        line-height: 1.3;
        color: var(--text);
      }
      .bl-sub {
        display: block;
        margin-top: 5px;
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--text-muted);
      }

      /* ---------- responsive ---------- */
      @media (max-width: 1080px) {
        .grid {
          grid-template-columns: 180px minmax(0, 1fr);
        }
        .rail-right {
          grid-column: 1 / -1;
          position: static;
          display: grid;
          grid-template-columns: repeat(2, 1fr);
          gap: 32px;
          border-top: 1px solid var(--rule);
          padding-top: 28px;
        }
        .rail-right .panel:last-child {
          border-bottom: 0;
        }
      }
      @media (max-width: 760px) {
        .shell {
          padding: 0 20px;
        }
        .grid {
          grid-template-columns: 1fr;
          gap: 32px;
          padding: 28px 0;
        }
        .rail-left {
          position: static;
        }
        .rail-ornament {
          display: none;
        }
        .rail-right {
          grid-template-columns: 1fr;
        }
        .post-title {
          font-size: 34px;
        }
        .backlinks-inner {
          grid-template-columns: 1fr;
        }
        .backlinks-mark {
          display: none;
        }
        .backlink-grid {
          grid-template-columns: 1fr;
          border-left: 0;
        }
        .backlink-grid li {
          padding: 10px 0;
          border-right: 0;
          border-bottom: 1px solid var(--rule);
        }
      }
    </style>
  </body>
</html>
