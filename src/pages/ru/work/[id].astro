---
import { getCollection } from 'astro:content';
import { getEntry } from '../../../lib/registry';
import CasePage from '../../../views/CasePage.astro';

export async function getStaticPaths() {
  const blog = await getCollection('blog');
  const cases = blog.filter((entry) => entry.data.language === 'ru' && entry.data.contentType === 'case');
  return cases.map((entry) => {
    const slug = entry.id.replace(/^ru\//, '');
    return {
      params: { id: slug },
    };
  });
}

const { id } = Astro.params;
const entry = await getEntry('ru', id);
---
<CasePage language="ru" entry={entry} />
