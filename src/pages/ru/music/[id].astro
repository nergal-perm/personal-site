---
import { getCollection } from 'astro:content';
import { getEntry } from '../../../lib/registry';
import AlbumPage from '../../../views/AlbumPage.astro';

export async function getStaticPaths() {
  const music = await getCollection('music');
  const albums = music.filter((entry) => entry.data.language === 'ru');
  return albums.map((entry) => {
    const slug = entry.id.replace(/^ru\//, '');
    return {
      params: { id: slug },
    };
  });
}

const { id } = Astro.params;
const entry = await getEntry('ru', id);
---
<AlbumPage language="ru" entry={entry} />
