---
import { getCollection } from 'astro:content';
import { getEntry } from '../../../lib/registry';
import ConceptPage from '../../../views/ConceptPage.astro';

export async function getStaticPaths() {
  const concepts = await getCollection('concepts');
  const items = concepts.filter((entry) => entry.data.language === 'en');
  return items.map((entry) => {
    const slug = entry.id.replace(/^en\//, '');
    return {
      params: { id: slug },
    };
  });
}

const { id } = Astro.params;
const entry = await getEntry('en', id);
---
<ConceptPage language="en" entry={entry} />
