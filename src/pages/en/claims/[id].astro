---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { getEntry } from '../../../lib/registry';
import ClaimPage from '../../../views/ClaimPage.astro';

export async function getStaticPaths() {
  const blog = await getCollection('blog');
  const claims = blog.filter((entry) => entry.data.language === 'en' && entry.data.contentType === 'claim');
  return claims.map((entry) => {
    const slug = entry.id.replace(/^en\//, '');
    return {
      params: { id: slug },
      props: { contentEntry: entry },
    };
  });
}

interface Props {
  contentEntry: CollectionEntry<'blog'>;
}

const { id } = Astro.params;
const { contentEntry } = Astro.props;
const entry = await getEntry('en', id);
const { Content } = await render(contentEntry);
const hasBody = Boolean(contentEntry.body?.trim());
---
<ClaimPage language="en" entry={entry} Content={Content} hasBody={hasBody} />
