---
import { getCollection } from 'astro:content';
import { getEntry } from '../../../lib/registry';
import NotePage from '../../../views/NotePage.astro';

export async function getStaticPaths() {
  const blog = await getCollection('blog');
  const notes = blog.filter((entry) => entry.data.language === 'en' && entry.data.contentType === 'note');
  return notes.map((entry) => {
    const slug = entry.id.replace(/^en\//, '');
    return {
      params: { id: slug },
    };
  });
}

const { id } = Astro.params;
const entry = await getEntry('en', id);
---
<NotePage language="en" entry={entry} />
