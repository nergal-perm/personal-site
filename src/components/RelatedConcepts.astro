---
// A small, hand-placed relationship map (5 named nodes) — not a force graph.
// Dark central node in deep pine; dashed sea-glass spokes to two-line labels.
interface Props {
  center: string;
  nodes: string[]; // up to 5
}
const { center, nodes } = Astro.props;

// Fixed anchor slots around the centre, ordered like the reference layout.
const slots = [
  { x: 66, y: 40, anchor: "middle" }, // top-left
  { x: 236, y: 40, anchor: "middle" }, // top-right
  { x: 256, y: 104, anchor: "end" }, // right
  { x: 176, y: 184, anchor: "middle" }, // bottom
  { x: 48, y: 116, anchor: "start" }, // left
] as const;

const cx = 150;
const cy = 102;
const r = 30;

// Split a label into at most two lines for compact placement.
function twoLines(label: string): string[] {
  const words = label.split(" ");
  if (words.length < 2) return [label];
  const mid = Math.ceil(words.length / 2);
  return [words.slice(0, mid).join(" "), words.slice(mid).join(" ")];
}

const placed = nodes.slice(0, 5).map((label, i) => ({
  label,
  lines: twoLines(label),
  ...slots[i],
}));
---

<figure class="concept-map">
  <svg viewBox="0 0 300 210" width="100%" role="img" aria-label={`${center} related concepts`}>
    <!-- spokes -->
    {
      placed.map((n) => {
        const dx = n.x - cx;
        const dy = n.y - cy;
        const len = Math.hypot(dx, dy) || 1;
        // start just outside the disc, stop just short of the label
        const sx = cx + (dx / len) * (r + 3);
        const sy = cy + (dy / len) * (r + 3);
        const ex = n.x - (dx / len) * 20;
        const ey = n.y - (dy / len) * 12;
        return (
          <g>
            <line
              x1={sx}
              y1={sy}
              x2={ex}
              y2={ey}
              stroke="var(--sea-glass)"
              stroke-width="1"
              stroke-dasharray="3 3"
            />
            <circle cx={ex} cy={ey} r="2" fill="var(--sea-glass)" />
          </g>
        );
      })
    }

    <!-- central node -->
    <circle cx={cx} cy={cy} r={r} fill="var(--deep-pine)" />
    <text
      x={cx}
      y={cy + 4}
      text-anchor="middle"
      fill="#e9e5da"
      font-family="var(--font-sans)"
      font-size="13"
      font-weight="600">{center}</text>

    <!-- labels -->
    {
      placed.map((n) => (
        <text
          x={n.x}
          y={n.lines.length > 1 ? n.y - 5 : n.y + 3}
          text-anchor={n.anchor}
          fill="var(--text)"
          font-family="var(--font-sans)"
          font-size="11.5">
          {n.lines.map((line, li) => (
            <tspan x={n.x} dy={li === 0 ? 0 : 13}>
              {line}
            </tspan>
          ))}
        </text>
      ))
    }
  </svg>

  <a class="explore" href="#">Explore in Atlas →</a>
</figure>

<style>
  .concept-map {
    margin: 0;
  }
  .concept-map svg {
    display: block;
    overflow: visible;
  }
  .explore {
    display: inline-block;
    margin-top: 14px;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 15px;
    color: var(--link);
  }
</style>
