---
// A quiet botanical sprig — "evidence of life" ornament from the guide.
// Rendered in muted sea-glass/amber line work; never loud.
interface Props {
  size?: number;
  class?: string;
}
const { size = 92, class: className = "" } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 100 120"
  width={size}
  height={size * 1.2}
  fill="none"
  aria-hidden="true"
>
  <g stroke="var(--sea-glass)" stroke-width="1.3" stroke-linecap="round">
    <path d="M50 116 C50 86 50 60 50 30" />
    <!-- leaf pairs -->
    <path d="M50 40 C64 34 76 36 84 26 C72 24 58 28 50 40 Z" fill="var(--sea-glass)" fill-opacity="0.12" />
    <path d="M50 40 C36 34 24 36 16 26 C28 24 42 28 50 40 Z" fill="var(--sea-glass)" fill-opacity="0.12" />
    <path d="M50 58 C63 53 74 55 82 46 C70 44 57 47 50 58 Z" fill="var(--sea-glass)" fill-opacity="0.12" />
    <path d="M50 58 C37 53 26 55 18 46 C30 44 43 47 50 58 Z" fill="var(--sea-glass)" fill-opacity="0.12" />
    <path d="M50 76 C61 72 70 73 77 65 C67 64 56 66 50 76 Z" fill="var(--sea-glass)" fill-opacity="0.12" />
    <path d="M50 76 C39 72 30 73 23 65 C33 64 44 66 50 76 Z" fill="var(--sea-glass)" fill-opacity="0.12" />
    <path d="M50 30 C50 24 53 19 59 16" />
  </g>
</svg>
