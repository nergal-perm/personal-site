---
// FIG. N — the annotated process figure that sits under the abstract.
// Circular line-icon nodes joined by restrained arrows, one caption below.
// Follows the diagram rules in §3.4: thin strokes, labeled nodes, one highlight.
interface Step {
  n: number;
  label: string;
  icon: string;
}
interface Props {
  label?: string;
  title: string;
  caption: string;
  steps: Step[];
}
const { label = "FIG. 1", title, caption, steps } = Astro.props;

// Minimal line icons keyed by name; stroke inherits currentColor.
const icons: Record<string, string> = {
  grid: '<rect x="4.5" y="4.5" width="6" height="6" rx="1"/><rect x="13.5" y="4.5" width="6" height="6" rx="1"/><rect x="4.5" y="13.5" width="6" height="6" rx="1"/><rect x="13.5" y="13.5" width="6" height="6" rx="1"/>',
  filter: '<path d="M4 5h16l-6 7v6l-4 2v-8L4 5Z"/>',
  node: '<circle cx="12" cy="12" r="3.2"/><circle cx="5" cy="5" r="1.8"/><circle cx="19" cy="5" r="1.8"/><circle cx="19" cy="19" r="1.8"/><path d="M9.6 9.6 6.3 6.3M14.4 9.6l3.1-3.1M14.4 14.4l3.1 3.1"/>',
  bolt: '<path d="M13 3 5 13h5l-1 8 8-11h-5l1-7Z"/>',
  swap: '<path d="M5 9h12M13 5l4 4-4 4M19 15H7M11 19l-4-4 4-4"/>',
};
---

<figure class="fig">
  <figcaption class="fig-head">
    <span class="fig-label">{label}</span>
    <span class="fig-title">{title}</span>
  </figcaption>

  <div class="fig-flow">
    {
      steps.map((step, i) => (
        <>
          <div class="node">
            <span class="disc">
              <svg
                viewBox="0 0 24 24"
                width="24"
                height="24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={icons[step.icon] ?? icons.node}
              />
            </span>
            <span class="node-label">
              <span class="node-n">{step.n}</span> {step.label}
            </span>
          </div>
          {i < steps.length - 1 && (
            <span class="arrow" aria-hidden="true">
              <svg viewBox="0 0 32 12" width="32" height="12" fill="none">
                <path
                  d="M1 6h27m0 0-5-4m5 4-5 4"
                  stroke="var(--muted-ink)"
                  stroke-width="1.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
          )}
        </>
      ))
    }
  </div>

  <p class="fig-caption">{caption}</p>
</figure>

<style>
  .fig {
    margin: 30px 0 40px;
    border: 1px solid var(--rule-strong);
    border-radius: 6px;
    padding: 22px 26px 20px;
    background: color-mix(in srgb, var(--panel) 55%, var(--bg));
  }
  .fig-head {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 22px;
  }
  .fig-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--muted-ink);
  }
  .fig-title {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--text);
    letter-spacing: 0.01em;
  }
  .fig-flow {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 4px;
    flex-wrap: wrap;
  }
  .node {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    flex: 0 0 auto;
  }
  .disc {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 1.4px solid var(--sea-glass);
    display: grid;
    place-items: center;
    color: var(--deep-pine);
    background: var(--bg);
  }
  .node-label {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--text);
    white-space: nowrap;
  }
  .node-n {
    color: var(--muted-ink);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .arrow {
    flex: 1 1 auto;
    display: flex;
    justify-content: center;
    margin-top: 22px;
    min-width: 24px;
  }
  .fig-caption {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 15px;
    line-height: 1.5;
    color: var(--muted-ink);
    margin: 22px 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--rule);
  }

  @media (max-width: 620px) {
    .fig-flow {
      justify-content: flex-start;
      gap: 18px 20px;
    }
    .arrow {
      display: none;
    }
  }
</style>
