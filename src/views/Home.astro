---
// renderHome() прототипа — desktop overview из шести паттернов data-home-pattern.
import Base from '../layouts/Base.astro';
import AlbumCover from '../components/AlbumCover.astro';
import { UI, formatDate, type Language } from '../lib/site';
import { getEntry, resolveLinks } from '../lib/registry';

interface Props {
  language: Language;
}

const { language } = Astro.props;
const labels = UI[language];
const page = (await getEntry(language, 'home')).data;
const selected = await resolveLinks(language, page.selected);
const featuredCase = await getEntry(language, 'case-observable-publishing');
const album = await getEntry(language, 'album-spaces');
const routeUrl = async (id: string) => (await getEntry(language, id)).url;
const paths = await Promise.all(
  page.paths.map(async (path: any) => ({ ...path, url: await routeUrl(path.route) })),
);
const nowUrl = await routeUrl('now');
const essaysUrl = await routeUrl('essays');
const mapUrl = await routeUrl('map');
const conceptsUrl = (await getEntry(language, 'concepts')).url;
---

<Base language={language} title={page.title} description={page.summary} active="home" pageKind="home">
  <section class="home-overview">
    <div class="home-overview__hero" data-home-pattern="hero" data-component="hero">
      <div class="shell home-overview__hero-grid">
        <div class="home-overview__intro">
          <h1 id="page-title" tabindex="-1">{page.heroTitle}</h1>
          <div class="hero-underline" aria-hidden="true"></div>
          <p>{page.lead}</p>
        </div>
        <figure class="home-hero-media" data-component="hero-image">
          <img
            src="/assets/signal-and-tide-coast-panorama.png"
            alt={page.heroImageAlt}
            width="2172"
            height="724"
            decoding="async"
            fetchpriority="high"
            data-image-archetype="signal-and-tide"
          />
        </figure>
      </div>
    </div>

    <div class="shell home-overview__features">
      <article class="home-module home-module--templated home-module--focus" data-home-pattern="focus">
        <div class="eyebrow">
          <svg class="eyebrow-icon" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <circle cx="8" cy="8" r="7" />
            <circle cx="8" cy="8" r="2" />
            <path d="M8 1v2M8 13v2M1 8h2M13 8h2" />
          </svg>
          {page.focusLabel}
        </div>
        <h2 class="home-module__title">{page.focusTitle}</h2>
        <p class="home-module__copy">{page.focusText}</p>
        <a class="text-link" href={nowUrl}>{page.focusAction} <span aria-hidden="true">→</span></a>
      </article>

      <article class="home-module home-module--templated home-module--case" data-home-pattern="case">
        <div class="eyebrow">
          <svg class="eyebrow-icon" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M8 1.5l1.5 5 5 1.5-5 1.5-1.5 5-1.5-5-5-1.5 5-1.5z" />
            <circle cx="8" cy="8" r="1.5" />
          </svg>
          {page.featuredLabel}
        </div>
        <h2 class="home-module__title">{page.featuredTitle}</h2>
        <p class="home-module__copy">{page.featuredText}</p>
        <a class="text-link" href={featuredCase.url}>{labels.caseAction} <span aria-hidden="true">→</span></a>
      </article>

      <article class="home-module home-module--essays" data-home-pattern="essays">
        <div class="eyebrow">
          <svg class="eyebrow-icon" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M2.5 13V3a1.5 1.5 0 0 1 1.5-1.5h9.5a1.5 1.5 0 0 1 1.5 1.5v10a1.5 1.5 0 0 1-1.5 1.5H4a1.5 1.5 0 0 1-1.5-1.5z" />
            <path d="M5.5 5h5M5.5 8h5M5.5 11h3" />
          </svg>
          {page.selectedTitle}
        </div>
        <ol>
          {selected.map((item) => (
            <li>
              <a href={item.url}>
                <strong>{item.title}</strong>
                <time datetime={item.date}>{item.date ? formatDate(item.date, language) : ''}</time>
              </a>
            </li>
          ))}
        </ol>
        <a class="text-link" href={essaysUrl}>{labels.allEssays} <span aria-hidden="true">→</span></a>
      </article>

      <article class="home-module home-module--templated home-module--music" data-home-pattern="music">
        <div class="eyebrow">
          <svg class="eyebrow-icon" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M6 11V3.5l7-1.5v9" />
            <circle cx="4" cy="11" r="2" />
            <circle cx="11" cy="9.5" r="2" />
          </svg>
          {page.listeningLabel}
        </div>
        <h2 class="home-module__title">{album.data.artist}</h2>
        <div class="home-module__music-work">{album.data.work}</div>
        <div class="home-module__media">
          {album.data.cover ? (
            <img
              src={album.data.cover}
              alt={`${album.data.work} — ${album.data.artist}`}
              loading="lazy"
              decoding="async"
            />
          ) : (
            <AlbumCover alt={page.albumCoverAlt} />
          )}
        </div>
        <a class="text-link" href={album.url}>{page.listeningAction} <span aria-hidden="true">→</span></a>
      </article>
    </div>

    <div class="shell home-overview__lower">
      <nav class="home-paths" data-home-pattern="paths" aria-label={page.pathsTitle}>
        <div class="home-paths__header">
          <div class="eyebrow">
            <svg class="eyebrow-icon" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <circle cx="8" cy="8" r="7" />
              <path d="M10.8 5.2l-1.4 2.8-2.8 1.4 1.4-2.8 2.8-1.4z" fill="currentColor" stroke="none" />
              <path d="M10.8 5.2l-1.4 2.8-2.8 1.4 1.4-2.8 2.8-1.4z" />
            </svg>
            {language === 'ru' ? 'Идеи в связях' : 'Ideas in relation'}
          </div>
        </div>

        <div class="home-paths__content">
          <div class="home-paths__map">
            <svg viewBox="0 0 760 170" class="map-svg" aria-label="Horizontal concept map linking topics">
              <path d="M 134 85 Q 163 55 192 45" class="map-line" />
              <path d="M 288 45 Q 334 45 357 67" class="map-line" />
              <path d="M 134 95 Q 163 125 192 135" class="map-line" />
              <path d="M 288 135 Q 334 135 357 113" class="map-line" />
              <path d="M 403 67 Q 426 45 472 45" class="map-line" />
              <path d="M 568 45 Q 597 55 622 85" class="map-line" />
              <path d="M 403 113 Q 426 135 472 135" class="map-line" />
              <path d="M 568 135 Q 597 125 622 95" class="map-line" />

              <text x="160" y="65" class="map-plus-text">+</text>
              <text x="600" y="65" class="map-plus-text">+</text>
              <text x="435" y="125" class="map-plus-text">+</text>

              <a href={`/${language}/topics/systems/`} class="map-node-link">
                <rect x="46" y="72" width="88" height="36" rx="18" class="map-node-bg" />
                <text x="90" y="90" class="map-node-text">{language === 'ru' ? 'Системное' : 'Systems'}</text>
                <text x="90" y="100" class="map-node-text">{language === 'ru' ? 'мышление' : 'Thinking'}</text>
              </a>

              <a href={`/${language}/topics/thinking/`} class="map-node-link">
                <rect x="192" y="27" width="96" height="36" rx="18" class="map-node-bg" />
                <text x="240" y="45" class="map-node-text">{language === 'ru' ? 'Модели и' : 'Models &'}</text>
                <text x="240" y="55" class="map-node-text">{language === 'ru' ? 'абстракции' : 'Abstractions'}</text>
              </a>

              <a href={`/${language}/topics/systems/`} class="map-node-link">
                <rect x="192" y="117" width="96" height="36" rx="18" class="map-node-bg" />
                <text x="240" y="135" class="map-node-text">{language === 'ru' ? 'Границы и' : 'Boundaries'}</text>
                <text x="240" y="145" class="map-node-text">{language === 'ru' ? 'рамки' : '& Scope'}</text>
              </a>

              <a href={`/${language}/concepts/concept-working-artifacts/`} class="map-node-link">
                <circle cx="380" cy="90" r="32" class="map-node-center" />
                <text x="380" y="88" class="map-node-text-center">{language === 'ru' ? 'Рабочие' : 'Working'}</text>
                <text x="380" y="98" class="map-node-text-center">{language === 'ru' ? 'артефакты' : 'Artifacts'}</text>
              </a>

              <a href={`/${language}/topics/ai-work/`} class="map-node-link">
                <rect x="472" y="27" width="96" height="36" rx="18" class="map-node-bg" />
                <text x="520" y="45" class="map-node-text">{language === 'ru' ? 'ИИ в' : 'AI-assisted'}</text>
                <text x="520" y="55" class="map-node-text">{language === 'ru' ? 'работе' : 'Work'}</text>
              </a>

              <a href={`/${language}/topics/personal-systems/`} class="map-node-link">
                <rect x="472" y="117" width="96" height="36" rx="18" class="map-node-bg" />
                <text x="520" y="135" class="map-node-text">{language === 'ru' ? 'Свидетельства' : 'Evidence &'}</text>
                <text x="520" y="145" class="map-node-text">{language === 'ru' ? 'и валидация' : 'Validation'}</text>
              </a>

              <a href={`/${language}/topics/personal-systems/`} class="map-node-link">
                <rect x="622" y="72" width="96" height="36" rx="18" class="map-node-bg" />
                <text x="670" y="85" class="map-node-text">{language === 'ru' ? 'Личные' : 'Personal'}</text>
                <text x="670" y="95" class="map-node-text">{language === 'ru' ? 'системы' : 'Knowledge'}</text>
                <text x="670" y="105" class="map-node-text">{language === 'ru' ? 'знаний' : 'Systems'}</text>
              </a>
            </svg>
          </div>

          <div class="home-paths__actions">
            <a href={mapUrl} class="explore-map-link">
              <strong>{page.mapAction} <span aria-hidden="true">→</span></strong>
            </a>
            <a href={conceptsUrl} class="all-concepts-link">
              {language === 'ru' ? 'Все концепты' : 'View all concepts'}
            </a>
          </div>
        </div>
      </nav>
    </div>
  </section>
</Base>

<style>
  /* Линия-акцент под заголовком */
  .hero-underline {
    width: 48px;
    height: 4px;
    background-color: var(--amber);
    margin-top: clamp(16px, 2.2vw, 24px);
    margin-bottom: clamp(16px, 2.2vw, 24px);
    flex-shrink: 0;
  }

  /* Вводный блок Hero */
  .home-overview__intro h1 {
    font-family: var(--serif) !important;
    font-size: clamp(28px, 3.2vw, 42px) !important;
    line-height: 1.15 !important;
    font-weight: 540;
  }

  .home-overview__intro p {
    font-family: var(--sans) !important;
    font-size: clamp(11.5px, 0.95vw, 13.5px) !important;
    line-height: 1.55 !important;
    color: var(--muted-ink) !important;
  }

  /* Иконки в заголовках */
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-transform: uppercase;
    font-family: var(--mono) !important;
    font-size: 7.5px !important;
    letter-spacing: 0.05em !important;
    color: var(--muted) !important;
  }

  .eyebrow-icon {
    flex-shrink: 0;
    color: var(--sea-glass);
  }

  /* Overrides for homepage card headers and copy to make them compact and evenly distributed */
  .home-module__title {
    font-family: var(--serif);
    font-size: clamp(15px, 1.3vw, 18px) !important;
    font-weight: 540;
    line-height: 1.2 !important;
    height: auto !important;
    margin-top: 4px !important;
    margin-bottom: 8px !important;
    display: block !important;
    -webkit-line-clamp: unset !important;
    overflow: visible !important;
  }

  .home-module__copy {
    font-family: var(--sans);
    font-size: clamp(10.5px, 0.82vw, 11.5px) !important;
    line-height: 1.45 !important;
    height: auto !important;
    margin-bottom: 12px !important;
    display: block !important;
    -webkit-line-clamp: unset !important;
    overflow: visible !important;
    color: var(--muted) !important;
  }

  .focus-underline {
    width: 24px;
    height: 3px;
    background-color: var(--amber);
    margin-top: 12px;
    margin-bottom: 12px;
    flex-shrink: 0;
  }

  /* Схема во 2-й колонке (dossier trace) */
  .case-trace-svg {
    width: 100%;
    max-width: 180px;
    height: auto;
    margin-top: 10px;
  }

  /* Модуль эссе */
  .home-module--essays strong {
    font-family: var(--serif) !important;
    font-size: clamp(11px, 0.9vw, 13px) !important;
    font-weight: 540;
    line-height: 1.25 !important;
  }

  .home-module--essays time {
    font-family: var(--mono) !important;
    font-size: 7.5px !important;
    color: var(--muted) !important;
  }

  /* Модуль музыки */
  .home-module__music-work {
    font-family: var(--sans) !important;
    font-size: clamp(10.5px, 0.82vw, 11.5px) !important;
    color: var(--text) !important;
    font-weight: 500;
    margin-bottom: 4px;
  }

  .now-playing-label {
    font-family: var(--mono);
    font-size: 7px;
    font-weight: bold;
    text-transform: uppercase;
    color: var(--amber);
    margin-bottom: clamp(6px, 0.8vw, 12px);
  }

  /* Нижняя панель с картой концептов */
  .home-paths {
    display: flex !important;
    flex-direction: column !important;
    gap: 16px;
    width: 100%;
  }

  .home-paths__content {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    width: 100%;
  }

  @media (max-width: 900px) {
    .home-paths__content {
      flex-direction: column;
      align-items: stretch;
    }
  }

  .home-paths__map {
    flex: 1 1 auto;
    min-width: 0;
  }

  .home-paths__actions {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: center;
    padding-left: 20px;
    border-left: 1px solid var(--border);
    min-height: 80px;
  }

  @media (max-width: 900px) {
    .home-paths__actions {
      align-items: flex-start;
      padding-left: 0;
      border-left: none;
      border-top: 1px solid var(--border);
      padding-top: 16px;
    }
  }

  .explore-map-link {
    font-family: var(--serif);
    font-size: 14px;
    font-weight: 540;
    color: var(--text);
    text-decoration: none;
    margin-bottom: 8px;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--amber);
    display: inline-block;
  }

  .all-concepts-link {
    font-family: var(--sans);
    font-size: 11px;
    color: var(--muted);
    text-decoration: none;
  }

  /* SVG-карта */
  .map-svg {
    width: 100%;
    height: auto;
  }

  .map-line {
    stroke: var(--sea-glass);
    stroke-width: 1.2;
    stroke-dasharray: 2 3;
    fill: none;
  }

  .map-node-bg {
    fill: var(--surface-bg);
    stroke: var(--border);
    stroke-width: 1;
    transition: stroke 0.2s ease, fill 0.2s ease;
  }

  .map-node-bg:hover,
  .map-node-link:hover .map-node-bg {
    stroke: var(--amber);
    fill: var(--page-bg);
  }

  .map-node-center {
    fill: var(--pine);
    stroke: var(--sea-glass);
    stroke-width: 1.5;
  }

  .map-node-text {
    font-family: var(--serif);
    font-size: 8.5px;
    font-weight: 500;
    fill: var(--text);
    text-anchor: middle;
    pointer-events: none;
  }

  .map-node-text-center {
    font-family: var(--serif);
    font-size: 9px;
    font-weight: 600;
    fill: var(--paper);
    text-anchor: middle;
    pointer-events: none;
  }

  .map-plus-text {
    font-family: var(--mono);
    font-size: 8px;
    fill: var(--sea-glass);
    text-anchor: middle;
    pointer-events: none;
  }
</style>
