---
// renderAbout() прототипа: введение, три принципа и колофон с переходом на работы и сейчас.
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { type Language } from '../lib/site';
import { getEntry } from '../lib/registry';

interface Props {
  language: Language;
}

const { language } = Astro.props;
const page = (await getEntry(language, 'about')).data;

const workEntry = await getEntry(language, 'work');
const nowEntry = await getEntry(language, 'now');
---

<Base language={language} title={page.title} description={page.summary} active="about" pageKind="about">
  <PageHeader language={language} eyebrow={page.eyebrow} title={page.title} lead={page.summary} />
  
  <section class="shell about-lead">
    <p>{page.lead}</p>
  </section>

  <section class="shell principles-list">
    {page.principles.map(([title, text]: [string, string], index: number) => (
      <article>
        <span>{String(index + 1).padStart(2, '0')}</span>
        <div>
          <h2>{title}</h2>
          <p>{text}</p>
        </div>
      </article>
    ))}
  </section>

  <aside class="shell colophon">
    <strong>Colophon</strong>
    <p>{page.colophon}</p>
    <div>
      <a href={workEntry.url}>{language === 'ru' ? 'Работы' : 'Work'} →</a>
      <a href={nowEntry.url}>{language === 'ru' ? 'Сейчас' : 'Now'} →</a>
    </div>
  </aside>
</Base>
