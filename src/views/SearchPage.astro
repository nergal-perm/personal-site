---
// renderSearchPage() прототипа: страница поиска с фильтрами по типам и темам.
// Результаты будут отрисовываться на клиенте скриптом site.js.
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { UI, TOPICS, TYPE_LABELS, type Language } from '../lib/site';
import { getEntry } from '../lib/registry';

interface Props {
  language: Language;
}

const { language } = Astro.props;
const labels = UI[language];
const page = (await getEntry(language, 'search')).data;

const typeOptions = ['essay', 'case', 'note', 'album', 'book', 'concept', 'now', 'about'];
---

<Base language={language} title={page.title} description={page.summary} active="search" pageKind="search">
  <PageHeader language={language} eyebrow={page.eyebrow} title={page.title} lead={page.summary} />
  
  <section class="shell search-page">
    <div class="search-controls search-page__controls" data-component="search">
      <label class="search-field">
        <span>{labels.search}</span>
        <input
          type="search"
          value=""
          data-filter="page-query"
          placeholder={page.placeholder}
          autofocus
        />
      </label>
      <label>
        <span>{language === 'ru' ? 'Тип' : 'Type'}</span>
        <select data-filter="page-type">
          <option value="all">{labels.allTypes}</option>
          {typeOptions.map((type) => (
            <option value={type}>{TYPE_LABELS[type][language]}</option>
          ))}
        </select>
      </label>
      <label>
        <span>{language === 'ru' ? 'Тема' : 'Topic'}</span>
        <select data-filter="page-topic">
          <option value="all">{labels.allTopics}</option>
          {Object.entries(TOPICS).map(([key, label]) => (
            <option value={key}>{label[language]}</option>
          ))}
        </select>
      </label>
    </div>

    <div class="search-page__heading">
      <span>{labels.results}</span>
      <b>0</b>
    </div>

    <div id="page-search-results" class="article-list" aria-live="polite">
      <p class="empty-state">{labels.emptySearch}</p>
    </div>
  </section>
</Base>
