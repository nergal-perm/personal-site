---
// renderEssaysIndex() прототипа: сайдбар «Начать здесь» + фильтруемый архив.
// Начальный список отрендерен статически (сортировка «сначала базовые»);
// фильтры оживают клиентским скриптом поверх /{lang}/search-index.json.
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import ArticleRow from '../components/ArticleRow.astro';
import ShowcaseSidebar from '../components/ShowcaseSidebar.astro';
import CollectionSearchControls from '../components/CollectionSearchControls.astro';
import { plainText } from '../lib/rich-text';
import { UI, type Language } from '../lib/site';
import { getCollectionEntries, getEntry } from '../lib/registry';

interface Props {
  language: Language;
}

const { language } = Astro.props;
const labels = UI[language];
const page = (await getEntry(language, 'essays')).data;
const results = await getCollectionEntries(language, 'essay', page.pinned ?? [], page.featured ? [page.featured] : []);
const showcase = Array.isArray(page.showcase) ? page.showcase : [];
---

<Base language={language} title={plainText(page.title)} description={plainText(page.summary)} active="essays" pageKind="essays-index">
  <PageHeader language={language} eyebrow={page.eyebrow} title={page.title} lead={page.summary} />
  <div class:list={['shell', 'index-layout', { 'index-layout--single': showcase.length === 0 }]}>
    <ShowcaseSidebar language={language} title={page.showcaseTitle ?? labels.startHere} items={showcase} />
    <section class="index-main" aria-label={plainText(page.title)}>
      <CollectionSearchControls language={language} collectionType="essay" placeholder={page.searchPlaceholder ?? ''} resultsId="essay-results" />
      <div id="essay-results" class="article-list" aria-live="polite">
        {results.map((entry) => (
          <ArticleRow language={language} entry={entry} showType={false} />
        ))}
      </div>
    </section>
  </div>
</Base>
