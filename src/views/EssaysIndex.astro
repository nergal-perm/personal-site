---
// renderEssaysIndex() прототипа: сайдбар «Начать здесь» + фильтруемый архив.
// Начальный список отрендерен статически (сортировка «сначала базовые»);
// фильтры оживают клиентским скриптом поверх /{lang}/search-index.json.
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import ArticleRow from '../components/ArticleRow.astro';
import { TOPICS, TYPE_LABELS, UI, type Language } from '../lib/site';
import { getEntry, getSearchableEntries, resolveLinks, sortRows } from '../lib/registry';

interface Props {
  language: Language;
}

const { language } = Astro.props;
const labels = UI[language];
const page = (await getEntry(language, 'essays')).data;
const startRoutes = await resolveLinks(language, page.routes.map((route: any) => route.route));
const results = sortRows(await getSearchableEntries(language), 'foundational', language);
const filterTypes = ['essay', 'note', 'case', 'book', 'concept', 'album'];
---

<Base language={language} title={page.title} description={page.summary} active="essays" pageKind="essays-index">
  <PageHeader language={language} eyebrow={page.eyebrow} title={page.title} lead={page.summary} />
  <div class="shell index-layout">
    <aside class="index-sidebar">
      <div class="eyebrow">{page.startTitle}</div>
      <p>{page.startText}</p>
      <ol>
        {page.routes.map((route: any, index: number) => (
          <li>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <a href={startRoutes[index].url}>
              <strong>{route.title}</strong>
              <small>{route.text}</small>
            </a>
          </li>
        ))}
      </ol>
      <div class="sidebar-note">
        <strong>{page.listPrincipleTitle}</strong>
        <p>{page.listPrincipleText}</p>
      </div>
    </aside>
    <section class="index-main" aria-labelledby="materials-heading">
      <h2 id="materials-heading">{labels.allEssays}</h2>
      <div class="search-controls index-controls" data-component="search" aria-label={labels.filters}>
        <label class="search-field">
          <span>{labels.search}</span>
          <input type="search" data-filter="essay-query" placeholder={page.searchPlaceholder} />
        </label>
        <label>
          <span>{language === 'ru' ? 'Тема' : 'Topic'}</span>
          <select data-filter="essay-topic">
            <option value="all">{labels.allTopics}</option>
            {Object.entries(TOPICS).map(([id, label]) => (
              <option value={id}>{label[language]}</option>
            ))}
          </select>
        </label>
        <label>
          <span>{language === 'ru' ? 'Тип' : 'Type'}</span>
          <select data-filter="essay-type">
            <option value="all">{labels.allTypes}</option>
            {filterTypes.map((type) => (
              <option value={type}>{TYPE_LABELS[type][language]}</option>
            ))}
          </select>
        </label>
        <label>
          <span>{language === 'ru' ? 'Порядок' : 'Order'}</span>
          <select data-filter="essay-sort">
            <option value="foundational" selected>{labels.foundational}</option>
            <option value="latest">{labels.latest}</option>
          </select>
        </label>
      </div>
      <div id="essay-results" class="article-list" aria-live="polite">
        {results.map((entry) => (
          <ArticleRow language={language} entry={entry} />
        ))}
      </div>
    </section>
  </div>
</Base>
