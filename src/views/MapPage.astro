---
// renderMap() прототипа: интерактивная схема из шести областей с легендой.
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { UI, type Language } from '../lib/site';
import { getEntry } from '../lib/registry';

interface Props {
  language: Language;
}

const { language } = Astro.props;
const labels = UI[language];
const page = (await getEntry(language, 'map')).data;

const centerEntry = await getEntry(language, page.centerId);
const centerUrl = centerEntry.url;

const nodes = await Promise.all(
  page.nodes.map(async (node: any) => {
    const entry = await getEntry(language, node.id);
    return {
      ...node,
      url: entry.url,
    };
  })
);
---

<Base language={language} title={page.title} description={page.summary} active="map" pageKind="map">
  <PageHeader language={language} eyebrow={page.eyebrow} title={page.title} lead={page.summary} />
  <section class="shell atlas-section">
    <div class="atlas-map" data-component="system-diagram" aria-label={page.legend}>
      <a class="atlas-node atlas-node--center" href={centerUrl}>
        <strong>{page.center}</strong>
        <span>00</span>
      </a>
      {nodes.map((node: any, index: number) => (
        <a class={`atlas-node atlas-node--${index + 1}`} href={node.url}>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <strong>{node.label}</strong>
          <small>{node.relation}</small>
        </a>
      ))}
      <i class="atlas-line atlas-line--1"></i>
      <i class="atlas-line atlas-line--2"></i>
      <i class="atlas-line atlas-line--3"></i>
      <i class="atlas-line atlas-line--4"></i>
      <i class="atlas-line atlas-line--5"></i>
    </div>
    <aside class="atlas-legend">
      <strong>{labels.mapLegend}</strong>
      <p>{page.legend}</p>
      <ol>
        {nodes.map((node: any) => (
          <li>
            <a href={node.url}>{node.label}</a>
            <span>{node.relation}</span>
          </li>
        ))}
      </ol>
    </aside>
  </section>
</Base>
