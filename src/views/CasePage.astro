---
// renderCase() прототипа: паспорт кейса (dossier), секции, нерешённый вопрос.
import Base from '../layouts/Base.astro';
import MetaStrip from '../components/MetaStrip.astro';
import MiniSystemDiagram from '../components/MiniSystemDiagram.astro';
import RelatedStrip from '../components/RelatedStrip.astro';
import { type Language } from '../lib/site';
import { type SiteEntry } from '../lib/registry';

interface Props {
  language: Language;
  entry: SiteEntry;
}

const { language, entry } = Astro.props;
const data = entry.data;
const fields = data.fields as Record<string, string>;
const label = `${entry.typeLabel} · ${entry.topicLabels[0]}`;
---

<Base language={language} title={entry.title} description={entry.summary} active="work" pageKind="case">
  <article class="case-page">
    <header class="case-page__header">
      <div class="shell">
        <div class="case-page__title">
          <div>
            <div class="eyebrow">{label}</div>
            <h1 id="page-title" tabindex="-1">{entry.title}</h1>
            <p>{entry.summary}</p>
            <MetaStrip language={language} date={entry.date} updated={entry.updated} />
          </div>
          <div class="case-number">CASE<br /><b>01</b></div>
        </div>
        <MiniSystemDiagram language={language} />
      </div>
    </header>
    <div class="shell case-dossier">
      <aside>
        <strong>{language === 'ru' ? 'Паспорт кейса' : 'Case file'}</strong>
        <span>{entry.status}</span>
        <div class="revision-stamp">REV 02<br />{entry.updated}</div>
      </aside>
      <dl class="dossier-fields">
        {Object.entries(fields).map(([key, value]) => (
          <div><dt>{key}</dt><dd>{value}</dd></div>
        ))}
      </dl>
    </div>
    <section class="shell case-sections">
      {data.sections.map((section: any) => (
        <article>
          <span>{section.number}</span>
          <div>
            <h2>{section.title}</h2>
            <p>{section.text}</p>
          </div>
        </article>
      ))}
    </section>
    <aside class="shell unresolved" data-component="callout">
      <strong>{language === 'ru' ? 'Нерешенный вопрос' : 'Unresolved question'}</strong>
      <p>{data.unresolved}</p>
    </aside>
    <RelatedStrip language={language} links={entry.links} />
  </article>
</Base>
