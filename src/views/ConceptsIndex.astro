---
// renderConceptsIndex() прототипа.
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { type Language } from '../lib/site';
import { getEntry } from '../lib/registry';

interface Props {
  language: Language;
}

const { language } = Astro.props;
const page = (await getEntry(language, 'concepts')).data;
const primary = await getEntry(language, page.primary);
const map = await getEntry(language, 'map');
---

<Base language={language} title={page.title} description={page.summary} active="concepts" pageKind="concepts-index">
  <PageHeader language={language} eyebrow={page.eyebrow} title={page.title} lead={page.summary} />
  <section class="shell concept-index">
    <a href={primary.url} class="concept-index__primary">
      <span>01 / {page.primaryLabel.toUpperCase()}</span>
      <h2>{primary.title}</h2>
      <p>{primary.summary}</p>
    </a>
    <aside>
      <strong>{page.mapRuleLabel}</strong>
      <p>{page.mapHint}</p>
      <a class="text-link" href={map.url}>{page.mapAction} <span aria-hidden="true">→</span></a>
    </aside>
  </section>
</Base>
