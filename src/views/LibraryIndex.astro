---
// renderLibraryIndex() прототипа: сетка обложек + политика цитат.
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import BookCover from '../components/BookCover.astro';
import { type Language } from '../lib/site';
import { getEntry, resolveLinks } from '../lib/registry';

interface Props {
  language: Language;
}

const { language } = Astro.props;
const page = (await getEntry(language, 'library')).data;
const books = await resolveLinks(language, page.items);
---

<Base language={language} title={page.title} description={page.summary} active="library" pageKind="library-index">
  <PageHeader language={language} eyebrow={page.eyebrow} title={page.title} lead={page.summary} />
  <section class="shell library-grid">
    {books.map((book) => (
      <a class="book-card" href={book.url}>
        <BookCover />
        <span>
          <b>{book.title}</b>
          <small>{book.summary}</small>
          <em>{book.data.readingStatus}</em>
        </span>
      </a>
    ))}
    <aside class="quote-policy" data-component="callout">
      <strong>{page.quotePolicyLabel}</strong>
      <p>{page.quotePolicy}</p>
    </aside>
  </section>
</Base>
