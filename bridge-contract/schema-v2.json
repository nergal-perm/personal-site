{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://personal-site.internal/bridge-contract/schema-v2.json",
  "title": "Publication bridge response (schema v2)",
  "type": "object",
  "required": ["schemaVersion", "command", "ok", "status", "diagnostics", "workspaceHealth"],
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "type": "object",
        "required": ["command", "status"],
        "properties": {
          "command": { "const": "inspect-publication" },
          "status": { "const": "ready_for_review" }
        }
      },
      "then": { "type": "object", "required": ["reviewPlan"] }
    },
    {
      "if": {
        "type": "object",
        "required": ["command"],
        "properties": { "command": { "const": "refresh-publication-queue" } }
      },
      "then": {
        "type": "object",
        "required": ["updatedCount", "unchangedCount", "uncertainCount"]
      }
    }
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "command": {
      "type": "string",
      "enum": ["prepare", "inspect-publication", "mark-reviewed", "refresh-publication-queue"]
    },
    "ok": { "type": "boolean" },
    "status": { "type": "string" },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/definitions/diagnostic" }
    },
    "workspaceHealth": {
      "type": "array",
      "items": { "$ref": "#/definitions/diagnostic" }
    },
    "identity": {
      "type": "object",
      "required": ["publicCollection", "publicContentType", "publicId"],
      "additionalProperties": true,
      "properties": {
        "publicCollection": { "type": "string" },
        "publicContentType": { "type": "string" },
        "publicId": { "type": "string" }
      }
    },
    "candidateState": { "type": "string" },
    "approvedSnapshotState": { "type": "string" },
    "semanticReferenceState": { "type": "string" },
    "releaseState": { "type": "string" },
    "reviewPlan": { "$ref": "#/definitions/reviewPlan" },
    "updatedCount": { "type": "integer" },
    "unchangedCount": { "type": "integer" },
    "uncertainCount": { "type": "integer" }
  },
  "definitions": {
    "diagnostic": {
      "type": "object",
      "required": ["field", "message", "blocking"],
      "additionalProperties": true,
      "properties": {
        "field": { "type": "string" },
        "message": { "type": "string" },
        "blocking": { "type": "boolean" }
      }
    },
    "reviewPlan": {
      "type": "object",
      "required": ["baselineState", "targets"],
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": ["baselineState"],
            "properties": { "baselineState": { "const": "changed" } }
          },
          "then": {
            "type": "object",
            "required": ["diff"],
            "properties": {
              "diff": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/definitions/russianDiffLine" }
              }
            }
          }
        }
      ],
      "if": {
        "type": "object",
        "required": ["baselineState"],
        "properties": { "baselineState": { "enum": ["absent", "changed"] } }
      },
      "then": {
        "type": "object",
        "properties": {
          "targets": {
            "type": "array",
            "items": [
              {
                "type": "object",
                "properties": { "publishedPath": { "const": null } }
              },
              {
                "type": "object",
                "properties": { "publishedPath": { "const": null } }
              }
            ]
          }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "targets": {
            "type": "array",
            "items": [
              {
                "type": "object",
                "properties": { "publishedPath": { "type": "string" } }
              },
              {
                "type": "object",
                "properties": { "publishedPath": { "type": "string" } }
              }
            ]
          }
        }
      },
      "properties": {
        "baselineState": { "type": "string", "enum": ["absent", "changed", "complete"] },
        "diff": {
          "type": "array",
          "items": { "$ref": "#/definitions/russianDiffLine" }
        },
        "targets": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": [
            {
              "allOf": [
                { "$ref": "#/definitions/reviewTarget" },
                {
                  "type": "object",
                  "required": ["language"],
                  "properties": { "language": { "const": "ru" } }
                }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/definitions/reviewTarget" },
                {
                  "type": "object",
                  "required": ["language"],
                  "properties": { "language": { "const": "en" } }
                }
              ]
            }
          ]
        }
      }
    },
    "russianDiffLine": {
      "type": "object",
      "required": ["kind", "text"],
      "additionalProperties": true,
      "properties": {
        "kind": { "type": "string", "enum": ["UNCHANGED", "ADDED", "REMOVED"] },
        "text": { "type": "string" }
      }
    },
    "reviewTarget": {
      "type": "object",
      "required": ["language", "proposedPath", "publishedPath"],
      "additionalProperties": true,
      "properties": {
        "language": { "type": "string", "enum": ["ru", "en"] },
        "proposedPath": { "type": "string", "pattern": "^/" },
        "publishedPath": { "type": ["string", "null"] }
      }
    }
  }
}
